{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint_name}}"
    }
  },
  "5": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["4", 0],
      "clip": ["4", 1],
      "lora_name": "{{lora_name}}",
      "strength_model": "{{lora_strength}}",
      "strength_clip": "{{lora_strength}}"
    }
  },
  "6": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{refiner_checkpoint_name}}"
    }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["5", 1]
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["5", 1]
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler_name}}",
      "scheduler": "{{scheduler}}",
      "denoise": 1,
      "model": ["5", 0],
      "positive": ["8", 0],
      "negative": ["9", 0],
      "latent_image": ["7", 0]
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{refiner_steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler_name}}",
      "scheduler": "{{scheduler}}",
      "denoise": "{{refiner_denoise}}",
      "model": ["6", 0],
      "positive": ["8", 0],
      "negative": ["9", 0],
      "latent_image": ["10", 0]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["11", 0],
      "vae": ["6", 2]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "job_refiner_lora_{{seed}}",
      "images": ["12", 0]
    }
  }
}
