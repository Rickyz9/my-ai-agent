{
  "3": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{source_image}}"
    }
  },
  "4": {
    "class_type": "LoadImageMask",
    "inputs": {
      "image": "{{mask_image}}",
      "channel": "red"
    }
  },
  "5": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint_name}}"
    }
  },
  "6": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": {
      "pixels": ["3", 0],
      "vae": ["5", 2],
      "mask": ["4", 0],
      "grow_mask_by": 8
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["5", 1]
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["5", 1]
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler_name}}",
      "scheduler": "{{scheduler}}",
      "denoise": "{{denoise}}",
      "model": ["5", 0],
      "positive": ["7", 0],
      "negative": ["8", 0],
      "latent_image": ["6", 0]
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["5", 2]
    }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "inpaint_fix_{{seed}}",
      "images": ["10", 0]
    }
  }
}
