{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{checkpoint_name}}"
    }
  },
  "5": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{refiner_checkpoint_name}}"
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["4", 1]
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["4", 1]
    }
  },
  "9": {
    "class_type": "CLIPTextEncodeSDXLRefiner",
    "inputs": {
      "ascore": 6,
      "width": "{{width}}",
      "height": "{{height}}",
      "text": "{{prompt}}",
      "clip": ["5", 1]
    }
  },
  "10": {
    "class_type": "CLIPTextEncodeSDXLRefiner",
    "inputs": {
      "ascore": 2,
      "width": "{{width}}",
      "height": "{{height}}",
      "text": "{{negative_prompt}}",
      "clip": ["5", 1]
    }
  },
  "11": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "enable",
      "noise_seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler_name}}",
      "scheduler": "{{scheduler}}",
      "start_at_step": 0,
      "end_at_step": "{{refiner_start_step}}",
      "return_with_leftover_noise": "enable",
      "model": ["4", 0],
      "positive": ["7", 0],
      "negative": ["8", 0],
      "latent_image": ["6", 0]
    }
  },
  "12": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "disable",
      "noise_seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler_name}}",
      "scheduler": "{{scheduler}}",
      "start_at_step": "{{refiner_start_step}}",
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable",
      "model": ["5", 0],
      "positive": ["9", 0],
      "negative": ["10", 0],
      "latent_image": ["11", 0]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["5", 2]
    }
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "job_refiner_{{seed}}",
      "images": ["13", 0]
    }
  }
}
